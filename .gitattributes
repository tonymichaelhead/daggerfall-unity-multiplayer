# DFMP repository line-ending policy.
#
# Everything Git detects as text is stored in the index AND checked out with LF
# on every platform, regardless of a contributor's core.autocrlf / core.eol
# settings. This is what makes the policy durable for an open-source project:
# Git for Windows ships with core.autocrlf=true, so without this file every
# Windows contributor silently reintroduces CRLF.
#
# Consequence: CRLF can no longer enter the index. `git add` strips CR via the
# clean filter, so `git diff --check` will stop reporting carriage returns as
# "trailing whitespace", and tools that write CRLF on Windows become harmless.
#
# When rebasing on upstream DFU, set `git config merge.renormalize true` so that
# line-ending-only differences never produce conflicts.
* text=auto eol=lf

# --- Unity text assets -------------------------------------------------------
# Unity's YAML importer rejects stray CR and a missing final newline with
# "Parser Failure at line N: Expect ':' between key and value within mapping".
#
# Unity itself writes trailing spaces into .meta files ("userData: ",
# "assetBundleName: "). whitespace=-trailing-space stops `git diff --check` from
# reporting them, so any warning it does emit is a real one worth acting on.
*.meta               text eol=lf whitespace=-trailing-space
*.asmdef             text eol=lf
*.asmref             text eol=lf
*.unity              text eol=lf
*.prefab             text eol=lf
*.asset              text eol=lf
*.mat                text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.physicMaterial     text eol=lf
*.playable           text eol=lf
*.mixer              text eol=lf
*.shadervariants     text eol=lf
*.spriteatlas        text eol=lf
*.terrainlayer       text eol=lf
