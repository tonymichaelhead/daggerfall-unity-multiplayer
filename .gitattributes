# Keep DFMP-owned text files deterministic on Windows.
.gitattributes text eol=lf

/dfmp-server.json text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/.github/*.md text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

/Assets/DFMP/**/*.asmdef text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/Assets/DFMP/**/*.cs text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/Assets/DFMP/**/*.json text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/Assets/DFMP/**/*.md text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/Assets/DFMP/**/*.meta text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol