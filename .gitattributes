# Upstream DFU quest scripts contain significant/legacy trailing spaces.
Assets/StreamingAssets/Quests/*.txt         text eol=lf whitespace=-trailing-space
Assets/StreamingAssets/QuestPacks/**/*.txt  text eol=lf whitespace=-trailing-space

