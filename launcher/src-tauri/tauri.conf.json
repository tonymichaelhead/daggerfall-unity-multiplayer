{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DFMP Launcher",
  "version": "0.1.0",
  "identifier": "dev.dfmp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DFMP Launcher",
        "width": 620,
        "height": 680,
        "minWidth": 480,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Daggerfall Unity Multiplayer launcher"
  }
}
