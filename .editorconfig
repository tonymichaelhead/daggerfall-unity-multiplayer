root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Unity-generated YAML uses a 2-space indent. Never trim whitespace here, and
# never drop the final newline: Unity's .meta parser fails without it.
[*.{meta,unity,prefab,asset,mat,anim,controller,asmdef,asmref,physicMaterial}]
indent_size = 2
trim_trailing_whitespace = false

# Two trailing spaces are a significant line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

